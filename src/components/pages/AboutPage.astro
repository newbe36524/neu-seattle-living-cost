---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createT, rich, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = createT(locale);
---

<BaseLayout locale={locale} path="/about/" title={t('pages.about.title')}>
  <h1>{t('pages.about.title')}</h1>
  <p>{t('pages.about.intro')}</p>
  <h2>{t('pages.about.updateHeading')}</h2>
  <p set:html={rich(t('pages.about.updateBody'))} />
  <h2>{t('pages.about.languagesHeading')}</h2>
  <p>{t('pages.about.languagesBody')}</p>
  <h2>{t('pages.about.futureHeading')}</h2>
  <p class="muted">{t('pages.about.futureBody')}</p>
</BaseLayout>
