---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LedgerWorkbench from '../LedgerWorkbench.astro';
import { createT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = createT(locale);
---

<BaseLayout locale={locale} path="/" title={t('pages.home.title')}>
  <h1>{t('common.site.name')}</h1>
  <p>{t('pages.home.intro')}</p>
  <LedgerWorkbench locale={locale} />
</BaseLayout>
