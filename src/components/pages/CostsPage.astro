---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CostTable from '../CostTable.astro';
import SubmitDataLink from '../SubmitDataLink.astro';
import ShareChart from '../ShareChart.astro';
import YearChart from '../YearChart.astro';
import CommuteLine from '../CommuteLine.astro';
import AdviceList from '../AdviceList.astro';
import { ledgersFor } from '../../data/ledger';
import { categories, profiles } from '../../data/costs';
import { createT, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = createT(locale);
const ledgerOf = new Map(ledgersFor(locale).map((l) => [l.id, l]));
---

<BaseLayout locale={locale} path="/costs/" title={t('pages.costs.title')}>
  <h1>{t('pages.costs.title')}</h1>
  <p class="muted">{t('pages.costs.intro')}</p>
  <SubmitDataLink locale={locale} />
  {profiles.map((p) => {
    const pr = `data.profiles.${p.id}`;
    return (
      <section id={p.id}>
        <h2>{t(`${pr}.area`)} · {t(`${pr}.contributor`)}</h2>
        <p class="muted">{t('pages.home.collected', { summary: t(`${pr}.summary`), updated: p.updated })}</p>
        <CommuteLine ledger={ledgerOf.get(p.id)!} locale={locale} />
        <div class="charts">
          <ShareChart ledger={ledgerOf.get(p.id)!} locale={locale} />
          <YearChart ledger={ledgerOf.get(p.id)!} locale={locale} />
        </div>
        {categories.map((c) => <CostTable category={c} profile={p} locale={locale} />)}
        <AdviceList ledger={ledgerOf.get(p.id)!} locale={locale} />
      </section>
    );
  })}
</BaseLayout>
