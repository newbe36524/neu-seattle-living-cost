---
/**
 * 成本项与分类的图标:让每一行一眼能认出是什么。与 Glyph.astro 同一套画法(24×24、1.7 描边、圆头圆角、currentColor)。
 *
 * 键 = 成本项 id(categories.yaml)或 `cat-<分类 id>`。没有图标的键(新增了项目但还没画)不渲染任何东西,
 * 不会出错;要补图标,在下面的 PATHS 里加一项即可。图标只是辅助,文字标签才是信息,所以整体 aria-hidden。
 */
interface Props {
  name: string;
  size?: number;
}

const { name, size = 20 } = Astro.props;

