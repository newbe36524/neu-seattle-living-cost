  'cat-other': [{ d: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z' }, { d: 'M8 12h.01M12 12h.01M16 12h.01', dot: true }],
  'cat-setup': [{ d: 'M3.5 8 12 3.5 20.5 8v8L12 20.5 3.5 16z' }, { d: 'M3.5 8 12 12.5 20.5 8M12 12.5v8' }],
