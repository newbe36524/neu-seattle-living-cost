const parts = PATHS[name];
---

{parts && (
  <svg class="item-icon" data-icon={name} viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {parts.map((p) => <path d={p.d} stroke-width={p.dot ? 2.4 : undefined} />)}
  </svg>
)}
