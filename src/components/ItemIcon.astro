  'dining-out': [{ d: 'M6 3v6a2.5 2.5 0 0 0 5 0V3' }, { d: 'M8.5 3v18' }, { d: 'M17.5 21V3c-2.3 1.4-3.2 4-3.2 7.2h3.2' }],
