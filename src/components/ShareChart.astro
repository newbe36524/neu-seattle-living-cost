---
/**
 * 每月开销占比:分类环形图 + 带占比条的图例。
 *
 * 没有 JS 时图例本身就是图(每行一条按占比定长的横条,数字都在文字里);
 * 有 JS 时,环形图由 Chart.js 在进入视口后才加载并绘制,图例与环互相高亮。
 * 数字全部来自账本(ledger.ts),图表不产生新数字。
 */
import { chartStateOf, monthlyOfState, pctText, percentages } from '../data/charts';
import type { LedgerProfile } from '../data/ledger';
import { DEFAULT_MONTHS } from '../data/ledger';
import ItemIcon from './ItemIcon.astro';
import { createT, type Locale } from '../i18n';

interface Props {
  ledger: LedgerProfile;
  locale: Locale;
}

const { ledger, locale } = Astro.props;
const t = createT(locale);
const state = chartStateOf(ledger, DEFAULT_MONTHS);
const total = monthlyOfState(state);
const pct = percentages(state.groups.map((g) => g.value));
const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
const money = (n: number) => usd.format(Math.round(n));
const headingId = `share-${ledger.id}`;
const i18n = Object.fromEntries(['charts.share.tooltip'].map((k) => [k, t(k)]));
---

<section class="chart-card share" data-reveal="rise" data-share data-chart={JSON.stringify(state)} data-i18n={JSON.stringify(i18n)} aria-labelledby={headingId}>
  <h3 id={headingId}>{t('charts.share.heading')}</h3>
  <div class="share-body">
    <div class="donut" data-donut>
      <span class="donut-ring" aria-hidden="true"></span>
      <canvas data-canvas aria-hidden="true"></canvas>
      <div class="donut-center" aria-hidden="true">
        <span class="muted">{t('charts.share.center')}</span>
        <strong data-donut-total>{money(total)}</strong>
      </div>
    </div>
    <ul class="legend">
      {state.groups.map((g, i) => (
        <li data-legend={g.id} style={`--cat:var(--cat-${i % 6});--w:${pct[i]}%;--m:${g.value > 0 ? '3px' : '0px'}`}>
          <span class="lg-swatch" aria-hidden="true"></span>
          <span class="lg-name"><ItemIcon name={`cat-${g.id}`} size={18} />{g.label}</span>
          <span class="lg-amount" data-lg-amount>{money(g.value)}</span>
          <span class="lg-pct" data-lg-pct>{total > 0 ? `${pctText(g.value, pct[i])}%` : '—'}</span>
          <span class="lg-bar" aria-hidden="true"></span>
        </li>
      ))}
    </ul>
  </div>
  <p class="muted chart-note" data-share-note>{t('charts.share.note')}</p>
</section>

<noscript><style>.donut { display: none; }</style></noscript>
<script>
  import '../scripts/charts';
</script>
