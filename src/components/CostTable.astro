---
import { unitLabel, itemStatus, entryNote, type CostCategory, type Profile } from '../data/costs';
import { createT, defaultLocale, hasMessage, type Locale } from '../i18n';

interface Props {
  category: CostCategory;
  profile: Profile;
  locale: Locale;
}

const { category, profile, locale } = Astro.props;
const t = createT(locale);
const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
---

<section id={`${profile.id}-${category.id}`}>
  <h3>{t(`data.categories.${category.id}.title`)}</h3>
  <p class="muted">{t(`data.categories.${category.id}.description`)}</p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>{t('common.table.item')}</th>
          <th>{t('common.table.amount')}</th>
          <th>{t('common.table.period')}</th>
          <th>{t('common.table.note')}</th>
        </tr>
      </thead>
      <tbody>
        {category.items.map((item) => {
          const s = itemStatus(profile, item.id);
          const entry = s.kind === 'pending' ? profile.entries.find((e) => e.items.includes(item.id)) : s.entry;
          const note = entry ? entryNote(locale, profile, entry) : undefined;
          const hintKey = `data.items.${item.id}.hint`;
          return (
            <tr>
              <td>
                {t(`data.items.${item.id}.label`)}
                {hasMessage(defaultLocale, hintKey) && <span class="muted"> · {t(hintKey)}</span>}
              </td>
              <td class="amount">
                {s.kind === 'pending' && <span class="pending">{t('common.status.pending')}</span>}
                {s.kind === 'amount' && usd.format(s.amount)}
                {s.kind === 'amount' && s.entry.basis === 'estimate' && <span class="muted"> {t('common.status.estimate')}</span>}
                {s.kind === 'bundled' && <span class="muted">{t('common.status.bundled', { amount: usd.format(s.amount) })}</span>}
              </td>
              <td>{unitLabel(locale, item.unit)}</td>
              <td class="muted">{note ?? ''}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</section>
