---
import { unitLabel, itemStatus, type CostCategory, type Profile } from '../data/costs';

interface Props {
  category: CostCategory;
  profile: Profile;
}

const { category, profile } = Astro.props;
const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
---

<section id={`${profile.id}-${category.id}`}>
  <h3>{category.title}</h3>
  <p class="muted">{category.description}</p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>项目</th><th>金额</th><th>周期</th><th>说明</th></tr>
      </thead>
      <tbody>
        {category.items.map((item) => {
          const s = itemStatus(profile, item.id);
          const note = s.kind === 'pending' ? undefined : s.entry.note;
          return (
            <tr>
              <td>
                {item.label}
                {item.hint && <span class="muted"> · {item.hint}</span>}
              </td>
              <td class="amount">
                {s.kind === 'pending' && <span class="pending">待补充</span>}
                {s.kind === 'amount' && usd.format(s.amount)}
                {s.kind === 'amount' && s.entry.basis === 'estimate' && <span class="muted"> 估算</span>}
                {s.kind === 'bundled' && <span class="muted">含于合并项 {usd.format(s.amount)}</span>}
              </td>
              <td>{unitLabel[item.unit]}</td>
              <td class="muted">{note ?? ''}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</section>
