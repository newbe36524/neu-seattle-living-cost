---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, profiles, monthlyTotal, oneTimeTotal } from '../data/costs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
---

<BaseLayout title="首页">
  <h1>西雅图居住成本参考</h1>
  <p>
    面向东北大学(Northeastern University)西雅图校区学生,整理在西雅图生活的主要开销,
    帮助你在入学前做预算。每份数据都是一位同学的真实经历,标明区域与采集时间。
  </p>

  <div class="grid">
    {profiles.map((p) => {
      const { total, pending } = monthlyTotal(p);
      const once = oneTimeTotal(p);
      return (
        <a class="card" href={`${base}/costs/#${p.id}`} style="text-decoration:none;color:inherit">
          <h3>{p.area} · {p.contributor}</h3>
          <p class="muted">{p.summary}采集于 {p.updated}。</p>
          <p><strong>{usd.format(total)}</strong> <span class="muted">每月,已填写项合计</span></p>
          <p class="muted">{pending.length > 0 ? `尚未包含:${pending.join('、')}。` : '每月项目已全部填写。'}</p>
          <p>
            <strong>{usd.format(once.reported)}</strong>
            <span class="muted"> 一次性费用(申请费、押金);另有约 {usd.format(once.estimate)} 初次搬入采购,为估算值</span>
          </p>
        </a>
      );
    })}
  </div>

  <h2>成本分类</h2>
  <div class="grid">
    {categories.map((c) => (
      <div class="card">
        <h3>{c.title}</h3>
        <p class="muted">{c.description}</p>
      </div>
    ))}
  </div>
</BaseLayout>
