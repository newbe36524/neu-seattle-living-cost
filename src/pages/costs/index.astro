---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CostTable from '../../components/CostTable.astro';
import { categories, profiles } from '../../data/costs';
---

<BaseLayout title="成本明细">
  <h1>成本明细</h1>
  <p class="muted">金额单位为美元。尚未整理的项目显示为「待补充」。每份记录对应一位提供者的真实情况。</p>
  {profiles.map((p) => (
    <section id={p.id}>
      <h2>{p.area} · {p.contributor}</h2>
      <p class="muted">{p.summary}采集于 {p.updated}。</p>
      {categories.map((c) => <CostTable category={c} profile={p} />)}
    </section>
  ))}
</BaseLayout>
