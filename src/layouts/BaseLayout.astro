---
import '../styles/global.css';
import Footer from '@hagicode/hagilight/Footer';
import SEOHead from '@hagicode/hagilight/SEOHead';
import GoogleAnalytics from '@hagicode/hagilight-core/GoogleAnalytics';
import Analytics51LA from '@hagicode/hagilight-core/Analytics51LA';
import CookieConsent from '@hagicode/hagilight-core/CookieConsent';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '为东北大学西雅图校区学生整理的西雅图居住成本参考。' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname;
const siteName = '西雅图居住成本参考';
const fullTitle = `${title} · ${siteName}`;
const locale = 'zh-CN';
// HagiCode 共享的统计项目;仅生产构建渲染,访客同意后才加载。
const GOOGLE_ANALYTICS_ID = 'G-EN03FMT2Q4';
const FIFTY_ONE_LA_ID = 'L6b88a5yK4h2Xnci';

const nav = [
  { href: `${base}/`, label: '首页' },
  { href: `${base}/costs/`, label: '成本明细' },
  { href: `${base}/about/`, label: '关于与数据来源' },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <SEOHead
      site={Astro.site}
      siteSeo={{ title: siteName, description }}
      page={{ url: Astro.url, title: fullTitle, description }}
      locale={locale}
    />
    <GoogleAnalytics measurementId={GOOGLE_ANALYTICS_ID} consent={true} />
    <Analytics51LA siteId={FIFTY_ONE_LA_ID} consent={true} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={`${base}/`}>西雅图居住成本参考</a>
        <nav class="site-nav" aria-label="主导航">
          {nav.map((n) => (
            <a href={n.href} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <div class="site-disclaimer">
      <div class="container muted">
        数据仅供参考,实际费用因区域、户型与时间而异。
      </div>
    </div>
    <Footer locale={locale} consent={true} links={{ siteId: 'neu-seattle-living-cost' }} />
    <CookieConsent providers={['googleAnalytics', 'fiftyOneLa', 'posthog']} locale={locale} />
  </body>
</html>
