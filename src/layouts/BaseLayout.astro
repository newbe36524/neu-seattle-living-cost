---
import '../styles/global.css';
import Footer from '@hagicode/hagilight/Footer';
import SEOHead from '@hagicode/hagilight/SEOHead';
import GoogleAnalytics from '@hagicode/hagilight-core/GoogleAnalytics';
import Analytics51LA from '@hagicode/hagilight-core/Analytics51LA';
import { createT, defaultLocale, localeNames, localePath, locales, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** 页面在站内的路径(不含语言前缀),以 / 开头并以 / 结尾,例如 "/costs/" */
  path: string;
  title: string;
  description?: string;
}

const { locale, path, title } = Astro.props;
const t = createT(locale);
const description = Astro.props.description ?? t('common.site.description');
const current = Astro.url.pathname;
const siteName = t('common.site.name');
const fullTitle = `${title} · ${siteName}`;
// 每种语言的同一页面,供 hreflang 与语言切换器使用。
const alternates = locales.map((l) => ({
  locale: l,
  name: localeNames[l],
  href: localePath(l, path),
  url: new URL(localePath(l, path), Astro.site).href,
}));
// HagiCode 共享的统计项目;仅生产构建渲染。本站不展示隐私同意弹窗,统计直接加载。
const GOOGLE_ANALYTICS_ID = 'G-EN03FMT2Q4';
const FIFTY_ONE_LA_ID = 'L6b88a5yK4h2Xnci';

const nav = [
  { href: localePath(locale, '/'), label: t('common.nav.home') },
  { href: localePath(locale, '/costs/'), label: t('common.nav.costs') },
  { href: localePath(locale, '/about/'), label: t('common.nav.about') },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <SEOHead
      site={Astro.site}
      siteSeo={{ title: siteName, description }}
      page={{ url: Astro.url, title: fullTitle, description }}
      locale={locale}
    />
    {alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={a.url} />)}
    <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.locale === defaultLocale)?.url} />
    <GoogleAnalytics measurementId={GOOGLE_ANALYTICS_ID} />
    <Analytics51LA siteId={FIFTY_ONE_LA_ID} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={localePath(locale, '/')}>{siteName}</a>
        <nav class="site-nav" aria-label={t('common.nav.label')}>
          {nav.map((n) => (
            <a href={n.href} aria-current={current === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
          <details class="lang-switch">
            <summary aria-label={t('common.language.label')}>{localeNames[locale]}</summary>
            <ul>
              {alternates.map((a) => (
                <li>
                  <a href={a.href} lang={a.locale} hreflang={a.locale} aria-current={a.locale === locale ? 'true' : undefined}>{a.name}</a>
                </li>
              ))}
            </ul>
          </details>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <div class="site-disclaimer">
      <div class="container muted">
        {t('common.site.disclaimer')}
      </div>
    </div>
    {/* 本站不展示 HagiLight 的悬浮 promotion 卡片:不要在此引入 PromotoBanner。 */}
    <Footer locale={locale} links={{ siteId: 'neu-seattle-living-cost' }} />
  </body>
</html>
